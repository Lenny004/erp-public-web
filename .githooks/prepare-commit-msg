#!/bin/sh
# Elimina trailers Co-authored-by insertados automáticamente (p. ej. por el IDE)
# antes de que commit-msg valide el mensaje final.

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

# Filtra líneas Co-authored-by (cualquier capitalización).
TMP_FILE="${MSG_FILE}.tmp"
grep -viE '^Co-authored-by:' "$MSG_FILE" > "$TMP_FILE" || true
mv "$TMP_FILE" "$MSG_FILE"

exit 0
